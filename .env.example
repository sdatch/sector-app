# Copy to .env for local runs outside docker-compose. Inside compose these are
# set in docker-compose.yml; on Railway they are set as service variables.

ENVIRONMENT=development

# Snapshots (memory-mapped artifacts)
ARTIFACTS_DIR=./data/artifacts
MARKET_DATA_PROVIDER=synthetic
ACTIVE_SNAPSHOT_ID=synthetic-2024-12-31

# Database (Railway injects DATABASE_URL automatically)
DATABASE_URL=postgresql+asyncpg://sector:sector@localhost:5432/sector

# Auth
JWT_SECRET=dev-insecure-change-me
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend origin (CORS + cookie)
FRONTEND_ORIGIN=http://localhost:3000

# Rate limiting
COMPARISONS_PER_MINUTE=10

# --- Narration (optional LLM wording for suggested shifts; OFF by default) ---
# The math always decides which moves are shown and what every number is;
# narration only rewrites the sentence explaining a move. With this off the
# anthropic SDK is never imported, nothing leaves the process, and the client
# renders its own deterministic copy — the feature is complete without it.
#
# Turning it on sends sector names, weights and the computed deltas to
# Anthropic — never tickers, quantities or account value — and makes the UI
# show the matching disclosure (PRD NFR-3, §13).
NARRATION_ENABLED=false
# ANTHROPIC_API_KEY=sk-ant-...

# Dev/QA only, ignored when ENVIRONMENT=production: narrate from a local stub
# so the narrated UI can be reviewed with no key and no spend.
NARRATION_STUB=false

# Tuning, all optional — defaults shown.
# NARRATION_MODEL=claude-opus-5
# NARRATION_EFFORT=low
# NARRATION_MAX_TOKENS=3072      # thinking tokens count against this; don't
#                                # lowball it or replies truncate and are
#                                # rejected, i.e. permanent fallback
# NARRATION_TIMEOUT_S=8.0
# NARRATION_PER_MINUTE=5         # per user, separate from COMPARISONS_PER_MINUTE
# NARRATION_CACHE_SIZE=256

# --- Sector lookup (optional suggested sectors in the CSV preview; OFF) -----
# The lookup proposes, the user confirms, the stored row is truth: a suggested
# sector is used only if the user accepts it, and nothing here runs during a
# comparison. Turning it on lets a user click "check sectors" in the preview,
# which sends that file's TICKER SYMBOLS (never quantities, values, the file or
# user identity) to Anthropic, with the disclosure shown beside the button.
# Reuses ANTHROPIC_API_KEY above. Manual sector editing works with this off.
SECTOR_LOOKUP_ENABLED=false
# Dev/QA only, ignored when ENVIRONMENT=production: fake suggestions, no key.
SECTOR_LOOKUP_STUB=false

# Tuning, all optional — defaults shown.
# SECTOR_LOOKUP_MODEL=claude-opus-5-5
# SECTOR_LOOKUP_EFFORT=medium
# SECTOR_LOOKUP_MAX_SEARCHES=5     # web searches per model call
# SECTOR_LOOKUP_MAX_TOKENS=16000
# SECTOR_LOOKUP_TIMEOUT_S=60
# SECTOR_LOOKUP_PER_MINUTE=3       # per user; cache hits are exempt
# SECTOR_LOOKUP_MAX_TICKERS=100    # per request
# SECTOR_LOOKUP_BATCH_SIZE=25      # symbols per model call
# SECTOR_LOOKUP_CACHE_SIZE=2048
